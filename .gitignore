__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# Scratch output from probes. Anything a result rests on is committed
# deliberately, under results/, and never left here.
scratch/

# LaTeX build products. IEEEtran.cls and IEEEtran.bst are vendored and are
# committed on purpose; everything derived from them is not. The PDF is
# committed at milestones rather than on every build.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.run.xml
paper/*.synctex.gz
paper/paper.pdf
# The signed circulation copy, built by `make named`. Derived from the same
# source as the anonymous one and never the artefact of record.
paper/paper-named.*
# Raster previews of the figure, rendered to look at it during development.
# The figure itself is committed; these are not.
paper/generated/*.png
